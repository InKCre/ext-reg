{
  "$defs": {
    "ModuleFederationAssociationInput": {
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Id"
        },
        "host_sdk": {
          "const": "@inkcre/core",
          "title": "Host Sdk",
          "type": "string"
        },
        "host_sdk_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Host Sdk Version",
          "type": "string"
        },
        "source_repository": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Repository",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "host_sdk",
        "host_sdk_version",
        "source_repository",
        "source_revision"
      ],
      "title": "ModuleFederationAssociationInput",
      "type": "object"
    },
    "PythonAssociationInput": {
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Id"
        },
        "entry_point": {
          "$ref": "#/$defs/PythonEntryPoint"
        },
        "host_sdk": {
          "const": "core-py",
          "title": "Host Sdk",
          "type": "string"
        },
        "host_sdk_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Host Sdk Version",
          "type": "string"
        },
        "project": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,198}[A-Za-z0-9])?$",
          "title": "Project",
          "type": "string"
        },
        "source_repository": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Repository",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "project",
        "host_sdk",
        "host_sdk_version",
        "entry_point",
        "source_repository",
        "source_revision"
      ],
      "title": "PythonAssociationInput",
      "type": "object"
    },
    "PythonEntryPoint": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
          "title": "Group",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "object": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*(?::[A-Za-z_][A-Za-z0-9_.]*)?$",
          "title": "Object",
          "type": "string"
        }
      },
      "required": [
        "group",
        "name",
        "object"
      ],
      "title": "PythonEntryPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "module_federation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModuleFederationAssociationInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "nickname": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Nickname",
      "type": "string"
    },
    "python": {
      "anyOf": [
        {
          "$ref": "#/$defs/PythonAssociationInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "version": {
      "maxLength": 128,
      "minLength": 5,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)))*)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "nickname",
    "version"
  ],
  "title": "PrepareReleaseRequest",
  "type": "object"
}
