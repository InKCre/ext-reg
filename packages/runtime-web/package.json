{
  "name": "@inkcre/extension-runtime",
  "version": "0.1.1",
  "description": "Browser Runtime/API contract for InKCre Extensions",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InKCre/ext-reg.git",
    "directory": "packages/runtime-web"
  },
  "type": "module",
