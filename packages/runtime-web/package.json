    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "tsdown": "0.22.13",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
