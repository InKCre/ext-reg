{
  "name": "@inkcre/extension-runtime-client-web",
  "version": "0.4.1",
  "description": "InKCre Client Web Extension Host Runtime",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsdown --platform neutral",
    "check:boundaries": "pnpm build && node check-boundaries.mjs",
    "check:bindings": "pnpm generate:bindings && git diff --exit-code -- src/generated",
    "generate:bindings": "openapi-ts -f openapi-ts.config.ts && prettier --write src/generated",
    "type-check": "tsc --noEmit",
    "pack": "pnpm pack"
  },
  "dependencies": {
    "semver": "7.8.5",
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "@inkcre/core": ">=0.4.2 <0.5.0",
    "@module-federation/runtime": ">=0.21.4 <0.23.0"
  },
  "devDependencies": {
    "@inkcre/core": "https://github.com/InKCre/impl-ts/releases/download/core-v0.4.2/inkcre-core-0.4.2.tgz",
    "@module-federation/runtime": "0.21.6",
    "@types/semver": "7.7.1",
    "@vueuse/core": "14.1.0",
    "pinia": "3.0.3",
    "tsdown": "0.22.13",
    "typescript": "5.9.3",
    "vue": "3.5.18"
  }
}
