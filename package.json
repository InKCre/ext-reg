{
  "name": "@inkcre/extension-registry-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "uv build --all-packages",
    "check": "pnpm contracts:check && pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm worker:build",
    "contracts:check": "uv run python scripts/generate_contracts.py --check",
    "contracts:generate": "uv run python scripts/generate_contracts.py",
    "format": "uv run ruff format . && prettier --write .",
    "format:check": "uv run ruff format --check . && prettier --check .",
    "lint": "uv run ruff check .",
    "test": "uv run pytest",
    "type-check": "uv run pyright",
    "worker:build": "uv build --all-packages && UV_FIND_LINKS=dist uv run pywrangler deploy --dry-run --outdir dist/worker"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "wrangler": "4.120.0"
  }
}
